# Append to /config/automations.yaml (or create via the Automations UI).
# Starts the bridge ~2 minutes after Home Assistant finishes booting.
#
# HISTORY: retired venv method. On the live machine this was automation
# id '1783465654554' - delete it when switching to the ca350_bridge add-on.
- alias: Start ca350 bridge on HA start
  triggers:
    - event: start
      trigger: homeassistant
  conditions: []
  actions:
    - delay: "00:02:00"
    - action: shell_command.start_ca350
  mode: single
